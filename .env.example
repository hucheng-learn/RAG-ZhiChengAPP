# ZhiChengApp 本地配置
# 首次使用：复制为 .env，再运行 python -m scripts.configure_local。

# ===== 应用 =====
ZHICHENGAPP_APP_NAME=知成 ZhiChengApp
ZHICHENGAPP_LOG_LEVEL=INFO
# 默认写入项目根目录 logs/zhichengapp.log；自定义路径可使用绝对路径。
# ZHICHENGAPP_LOG_FILE=D:/code_workspace/ZhiChengApp/logs/zhichengapp.log
ZHICHENGAPP_LOG_MAX_BYTES=10485760
ZHICHENGAPP_LOG_BACKUP_COUNT=5
ZHICHENGAPP_DEPENDENCY_TIMEOUT_SECONDS=3

# ===== 大模型服务（需要填写） =====
ZHICHENGAPP_LLM_BASE_URL=
ZHICHENGAPP_LLM_API_KEY=
ZHICHENGAPP_LLM_MODEL=
ZHICHENGAPP_LLM_TIMEOUT_SECONDS=90

# ===== 聊天语音输入（复用 ZHICHENGAPP_LLM_API_KEY，须与地域一致） =====
ZHICHENGAPP_ASR_MODEL=qwen-audio-3.1-asr-flash
# 默认北京；也可填写业务空间专属域名的完整接口地址。
ZHICHENGAPP_ASR_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
ZHICHENGAPP_ASR_TIMEOUT_SECONDS=60

# ===== 本地模型（需要填写模型目录） =====
ZHICHENGAPP_EMBEDDING_MODEL_PATH=
ZHICHENGAPP_RERANKER_MODEL_PATH=
# cuda:0 使用第一张显卡；无可用 CUDA 时改为 cpu。
ZHICHENGAPP_MODEL_DEVICE=cuda:0
ZHICHENGAPP_LOAD_LOCAL_MODELS=true
ZHICHENGAPP_MODEL_BATCH_SIZE=8
ZHICHENGAPP_MODEL_CONCURRENCY=1

# ===== MongoDB 数据库（本地初始化脚本自动填写连接与凭据） =====
ZHICHENGAPP_MONGO_URI=
ZHICHENGAPP_MONGO_DATABASE=zhichengapp
ZHICHENGAPP_MONGO_USER=zhichengapp_admin
ZHICHENGAPP_MONGO_PASSWORD=

# ===== Milvus 向量存储 =====
ZHICHENGAPP_MILVUS_URI=
ZHICHENGAPP_MILVUS_TOKEN=
ZHICHENGAPP_MILVUS_COLLECTION=zhichengapp_chunks
ZHICHENGAPP_MILVUS_PASSWORD=

# ===== MinIO 原件存储 =====
# endpoint 不带 http:// 或 https://。
ZHICHENGAPP_MINIO_ENDPOINT=
ZHICHENGAPP_MINIO_ACCESS_KEY=
ZHICHENGAPP_MINIO_SECRET_KEY=
ZHICHENGAPP_MINIO_SECURE=false
ZHICHENGAPP_MINIO_BUCKET=zhichengapp-files

# ===== 文件导入 =====
# 单文件上限 200 MB；DOCX / MinerU 结果解压后上限 200 MB。
ZHICHENGAPP_MAX_UPLOAD_BYTES=209715200
ZHICHENGAPP_MAX_DOCX_UNPACKED_BYTES=209715200
ZHICHENGAPP_IMPORT_QUEUE_SIZE=8

# ===== 文本分块 =====
ZHICHENGAPP_CHUNK_TARGET_TOKENS=512
ZHICHENGAPP_CHUNK_MAX_TOKENS=768
ZHICHENGAPP_CHUNK_OVERLAP_TOKENS=64

# ===== 检索与回答 =====
ZHICHENGAPP_RETRIEVAL_LIMIT=20
ZHICHENGAPP_RERANK_LIMIT=5
ZHICHENGAPP_CONTEXT_MAX_TOKENS=4000
# 保持 0 表示不按未经校准的重排分数过滤。
ZHICHENGAPP_MIN_RELEVANCE_SCORE=0

# ===== Docker 镜像 =====
# 留空使用 compose.yml 默认镜像；离线环境可填写本地已有的镜像名。
ZHICHENGAPP_ETCD_IMAGE=
ZHICHENGAPP_MINIO_IMAGE=
ZHICHENGAPP_MILVUS_IMAGE=
ZHICHENGAPP_MONGO_IMAGE=

# ===== 本地初始化状态（由脚本维护） =====
ZHICHENGAPP_DEPLOYMENT_CONFIGURED=0

# ===== MinerU 文档 / 图片解析（v4 API） =====
# 未配置时 Markdown / DOCX 仍可本地解析；PDF、PPT、DOC、图片 OCR 需要令牌。
ZHICHENGAPP_MINERU_BASE_URL=https://mineru.net/api/v4
ZHICHENGAPP_MINERU_API_TOKEN=
ZHICHENGAPP_MINERU_MODEL_VERSION=vlm
ZHICHENGAPP_MINERU_TIMEOUT_SECONDS=1800
ZHICHENGAPP_MAX_BATCH_FILES=200
ZHICHENGAPP_MAX_BATCH_BYTES=209715200

# CDN 结果下载默认直连；如必须经系统代理下载，设为 true。
ZHICHENGAPP_MINERU_DOWNLOAD_TRUST_ENV=false
